{
  "private": true,
  "name": "@cssninja/apollux-demo",
  "version": "0.0.0",
  "type": "module",
  "main": "./nuxt.config.ts",
  "scripts": {
    "prepare": "nuxi prepare",
    "clean": "rimraf .nuxt .output node_modules"
  },
  "devDependencies": {
    "@fontsource-variable/fira-code": "^5.0.8",
    "@fontsource-variable/inter": "^5.0.8",
    "@fontsource-variable/karla": "^5.0.13",
    "@fontsource-variable/roboto-flex": "^5.0.8",
    "@parcel/watcher": "2.3.0",
    "@popperjs/core": "2.11.8",
    "@types/chroma-js": "^2.4.1",
    "@vueform/slider": "2.1.7",
    "apexcharts": "3.42.0",
    "axe-core": "4.8.1",
    "chroma-js": "^2.4.2",
    "date-fns": "2.30.0",
    "imask": "7.1.3",
    "magic-string": "0.30.3",
    "nuxt": "3.6.5",
    "nuxt-swiper": "1.2.2",
    "rehype-external-links": "3.0.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.0",
    "rehype-shikiji": "0.6.8",
    "remark-gfm": "3.0.1",
    "remark-parse": "10.0.2",
    "remark-rehype": "11.0.0",
    "shikiji": "0.6.8",
    "splitpanes": "3.1.5",
    "unified": "11.0.3",
    "v-calendar": "3.0.1",
    "vue-axe": "3.1.2",
    "vue3-apexcharts": "1.4.4",
    "vue3-carousel": "0.3.1",
    "vue3-popper": "1.5.0",
    "vue3-smooth-dnd": "0.0.6"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.(ts|vue)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "postcss",
        "vue",
        "vite",
        "@unhead/vue",
        "webpack"
      ]
    },
    "patchedDependencies": {
      "smooth-dnd@0.12.1": "patches/smooth-dnd@0.12.1.patch"
    }
  }
}